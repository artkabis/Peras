ir:
export fn fib(%0 n: i32) -> i32
  if (i32.< %0 2:i32)
    return %0
  return (i32.+ (call #0 (i32.- %0 1:i32)) (call #0 (i32.- %0 2:i32)))
export fn mean(%0 total: f64, %1 count: i32) -> f64
  if (i32.== %1 0:i32)
    return 0.0:f64
  return (f64./ %0 (f64.from_i32 %1))
export fn clamp(%0 x: i64, %1 low: i64, %2 high: i64) -> i64
  if (i64.< %0 %1)
    return %1
  if (i64.> %0 %2)
    return %2
  return %0
