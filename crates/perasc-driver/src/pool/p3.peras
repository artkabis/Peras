// Decision 0044, prototype p3: `Pool<T>` written in Peras, shipped with the
// compiler and imported, `import { Pool, Handle } from "peras:pool"`. Its
// handles carry a generation, as p1's do; a structure cannot define `[]`,
// so a program reaches a value through `slot(h)`, `None` for a handle whose
// value was removed, and indexes `values` with it.

struct Handle {
  slot: i32;
  gen: i32;
}

struct Pool<T> {
  values: Array<T>;
  gens: Array<i32>;
  live: Array<bool>;
  free: Array<i32>;
  count: i32;
}

impl<T> Pool<T> {
  fn new(): Self {
    return Pool([], [], [], [], 0);
  }

  fn insert(inout self, v: sink T): Handle {
    self.count += 1;
    if (self.free.length > 0) {
      const s = self.free.pop().unwrapOr(0);
      self.values[s] = v;
      self.live[s] = true;
      return Handle(s, self.gens[s]);
    }
    self.values.push(v);
    self.gens.push(0);
    self.live.push(true);
    return Handle(self.values.length - 1, 0);
  }

  fn has(self, h: Handle): bool {
    return h.slot >= 0 && h.slot < self.live.length && self.live[h.slot] && self.gens[h.slot] == h.gen;
  }

  fn remove(inout self, h: Handle): bool {
    if (!self.has(h)) {
      return false;
    }
    self.live[h.slot] = false;
    self.gens[h.slot] += 1;
    self.free.push(h.slot);
    self.count -= 1;
    return true;
  }

  fn size(self): i32 {
    return self.count;
  }

  fn handles(self): Array<Handle> {
    let all: Array<Handle> = [];
    for (let s = 0; s < self.live.length; s++) {
      if (self.live[s]) {
        all.push(Handle(s, self.gens[s]));
      }
    }
    return all;
  }

  fn slot(self, h: Handle): Option<i32> {
    if (self.has(h)) {
      return Some(h.slot);
    }
    return None;
  }
}

impl<T: Copy> Pool<T> {
  fn get(self, h: Handle): Option<T> {
    if (self.has(h)) {
      return Some(self.values[h.slot]);
    }
    return None;
  }
}
