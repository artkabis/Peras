---
source: crates/perasc-syntax/tests/ui.rs
expression: render_parsed(&source)
input_file: tests/ui/parser/struct.peras
---
ast:
  (struct Buffer export (samples Array<f32>))
  (struct Point (x f64) (y f64))
  (struct Pixel (r u8) (g u8) (b u8) (a u8))
  (struct Empty)
  (fn peak export (params (buf Buffer)) -> Option<f32>
    (if (== (. (. buf samples) length) 0)
      (return None)
    )
    (let max: f32 0.0)
    (for-of (const s) (. buf samples)
      (block
        (if (> (call (. s abs)) max)
          (= max (call (. s abs)))
        )
      )
    )
    (return (call Some max))
  )
diagnostics:
  none
