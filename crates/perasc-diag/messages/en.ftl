# English messages — source of truth.
# Every key here must exist in fr.ftl; CI fails otherwise.

cli-version = perasc { $version }
cli-usage =
    Usage: perasc <command> [options]

    Commands:
      check <file>...    check .peras and .apeiron files and report every error
      build <file>       compile a .peras file to WebAssembly, or a .apeiron file to JavaScript
      explain <code>     explain an error code, e.g. `perasc explain E0001`

    Options:
      --lang <en|fr>     language of messages (default: PERAS_LANG, then the system locale)
      --json             print the diagnostics of `check` and `build` as JSON on standard output
      --backend <name>   code generator of `build`: direct (default, no other tool) or rust (cargo, wasm-bindgen)
      --out <dir>        output folder of `build` (default: dist)
      --no-optimize      skip the IR optimizations of `build` (direct backend)
      --allocator <name> the build: debug (default, every memory bug and integer overflow caught) or tlsf (production, bounded time, integers wrap)
      --simd <on|off>    WebAssembly SIMD in loops and the runtime: on (default, faster) or off (loads in engines without it, as Safari before 16.4)
      --threads <on|off> `parallel for` loops on several threads, where the page is cross-origin isolated: off (default) or on
      --imports <how>    imports of .peras files in a .apeiron module: built (default, each next to it) or source (kept for a bundler such as Vite)
      --color <when>     colour diagnostics: auto (default), always, never; NO_COLOR is honoured
      -V, --version      print the version
      -h, --help         print this help
cli-unknown-argument = unknown argument `{ $argument }`
cli-unknown-command = unknown command `{ $command }`
cli-missing-value = `{ $option }` needs a value
cli-invalid-value = invalid value `{ $value }` for `{ $option }`
cli-no-files = `check` needs at least one file
cli-no-build-file = `build` needs a .peras or .apeiron file
cli-missing-code = `explain` needs an error code, e.g. E0001
cli-unknown-code = unknown error code `{ $code }`
cli-not-a-source = `{ $path }` is not a Peras source: the extension must be .peras or .apeiron
cli-not-found = `{ $path }` does not exist
cli-not-utf8 = `{ $path }` is not UTF-8 text
cli-read-error = cannot read `{ $path }`: { $reason }
cli-hidden-errors = { $count ->
    [one] 1 more error
   *[other] { $count } more errors
} in { $path }, not shown: the limit is { $limit } per file
cli-build-ok = { $file } compiled to { $out } ({ $bytes } bytes, { $ms } ms)
cli-write-error = cannot write the output: { $reason }
cli-tool-missing = `{ $tool }` is needed by the Rust backend but is not installed: install it, or use `--backend direct`
cli-tool-failed = `{ $tool }` failed on code generated by perasc: this is a bug in perasc, please report it with the output below
cli-internal-error = the IR verifier rejected the code perasc produced: this is a bug in perasc, please report it with the lines below
cli-summary-ok = { $files ->
    [one] 1 file checked, no error
   *[other] { $files } files checked, no error
}
cli-summary-errors = { $errors ->
    [one] 1 error: the build is blocked
   *[other] { $errors } errors: the build is blocked
}

## Lexer (E0001–E0099)

# E0001
lex-invalid-character = { $count ->
    [one] invalid character { $character } ({ $codepoint })
   *[other] { $count } invalid characters, starting with { $character } ({ $codepoint })
}
lex-invalid-character-label = { $count ->
    [one] this character is not allowed in Peras code
   *[other] these characters are not allowed in Peras code
}
lex-invalid-character-why = Outside strings and comments, Peras code only uses ASCII letters, digits, `_`, spaces and the operators of the language.
lex-invalid-character-fix-remove = { $count ->
    [one] remove this character
   *[other] remove these characters
}
lex-invalid-character-fix-replace = replace { $character } with `{ $replacement }`, the ASCII character it looks like
lex-invalid-character-fix-identifier = names use ASCII letters, digits and `_` only: rename it, e.g. `cafe` instead of `café`; to show text, put it in a string

# E0002
lex-unterminated-string = unterminated string
lex-unterminated-string-label = this string is never closed
lex-unterminated-string-end-label = the line ends here, before the closing `{ $quote }`
lex-unterminated-string-why = A string must close on the line where it starts; to put a line break in it, write `\n`.
lex-unterminated-string-fix = close the string with `{ $quote }`

# E0003
lex-unterminated-block-comment = unterminated block comment
lex-unterminated-block-comment-label = this comment is never closed
lex-unterminated-block-comment-why = A `/*` comment runs until the next `*/`; without one, the rest of the file is a comment.
lex-unterminated-block-comment-fix = close the comment with `*/`

# E0004
lex-invalid-escape = invalid escape sequence `{ $escape }`
lex-invalid-escape-unknown-label = `\{ $character }` is not an escape sequence
lex-invalid-escape-braces-label = Peras writes the code point between braces
lex-invalid-escape-unicode-label = not a valid Unicode escape
lex-invalid-escape-why = Strings accept only `\n`, `\r`, `\t`, `\0`, `\\`, `\'`, `\"` and `\u{"{"}…{"}"}` with 1 to 6 hexadecimal digits naming a Unicode scalar value.
lex-invalid-escape-fix-backslash = to write a backslash, double it: `\\`
lex-invalid-escape-fix-braces = write `{ $replacement }`
lex-invalid-escape-fix-unicode = write a code point from `\u{"{"}0{"}"}` to `\u{"{"}10FFFF{"}"}`, excluding the surrogates `\u{"{"}D800{"}"}` to `\u{"{"}DFFF{"}"}`

# E0005
lex-malformed-number = malformed number `{ $literal }`
lex-number-no-digits-label = no digits after `{ $prefix }`
lex-number-no-digits-why = A `0x`, `0o` or `0b` prefix must be followed by at least one digit.
lex-number-no-digits-fix = add digits after the prefix, e.g. `0xFF`
lex-number-invalid-digit-label = `{ $digit }` is not { $base ->
    [2] a binary
    [8] an octal
   *[other] a hexadecimal
} digit
lex-number-invalid-digit-why = Binary numbers (`0b`) use the digits 0 and 1, octal numbers (`0o`) 0 to 7, hexadecimal numbers (`0x`) 0 to 9 and a to f.
lex-number-invalid-digit-fix = remove the digit, or change the prefix to the right base
lex-number-leading-zero-label = leading zero
lex-number-leading-zero-why = In JavaScript, `012` used to mean an octal number; Peras forbids the ambiguity and writes octal numbers with `0o`.
lex-number-leading-zero-fix = remove the leading zeros
lex-number-leading-zero-fix-ambiguous = write `{ $octal }` for an octal number, or `{ $decimal }` for a decimal one
lex-number-underscore-label = `_` must sit between two digits
lex-number-underscore-why = Underscores separate groups of digits, as in `1_000_000`; they cannot start or end a number, touch a `.` or a prefix, or follow each other.
lex-number-underscore-fix = remove this `_`
lex-number-exponent-label = the exponent has no digits
lex-number-exponent-why = An exponent needs digits after `e`, as in `1e3` or `2.5e-4`.
lex-number-exponent-fix = add digits after `e`, or remove the `e`
lex-number-suffix-label = unexpected `{ $suffix }` after the number
lex-number-suffix-why = Number literals have no unit or type suffix: the type comes from the context or from an annotation.
lex-number-suffix-fix = remove `{ $suffix }`; to choose a type, annotate the variable, e.g. `let x: f32 = 5.0`
lex-number-radix-fraction-label = only decimal numbers can have a fraction
lex-number-radix-fraction-why = Hexadecimal, octal and binary numbers are integers; only decimal numbers have a fraction or an exponent.
lex-number-radix-fraction-fix = write the number in decimal

# E0006
lex-strict-equality = `{ $operator }` does not exist in Peras
lex-strict-equality-label = write `{ $replacement }`
lex-strict-equality-why = Peras never converts types implicitly, so `==` and `!=` already compare strictly, like `===` and `!==` in JavaScript.
lex-strict-equality-fix = replace `{ $operator }` with `{ $replacement }`

# E0007
lex-bidi-control = invisible bidirectional control character { $codepoint } ({ $name })
lex-bidi-control-label = this invisible character changes the order in which the code is displayed
lex-bidi-control-why = A bidirectional control character can make code look different from what it compiles to (the Trojan Source attack, CVE-2021-42574), so it is refused everywhere, strings and comments included.
lex-bidi-control-fix-remove = remove this character
lex-bidi-control-fix-escape = write it as the escape `{ $escape }`, which stays visible

# E0008
lex-source-too-large = source file too large
lex-source-too-large-label = this file is { $size } bytes long
lex-source-too-large-why = Source positions are 32-bit numbers, so a source file must be smaller than 4 GiB.
lex-source-too-large-fix = split this file into several modules

## Parser (E0100–E0199)

# E0100
parse-expected-expression = expected a value, found { $eof ->
    [1] the end of the file
   *[other] `{ $found }`
}
parse-expected-expression-label = a value is needed here
parse-expected-expression-why = An expression is needed at this point: a number, a string, a name, a call such as `f(x)`, or a calculation such as `a + 1`.
parse-expected-expression-fix = write the missing value, or remove what precedes this point

# E0101
parse-missing-semicolon = missing `;`
parse-missing-semicolon-label = the statement ends here
parse-missing-semicolon-why = Every statement ends with `;`. Peras does not guess where a statement ends, unlike JavaScript's automatic semicolon insertion, which can join two lines into one statement.
parse-missing-semicolon-fix = add `;`

# E0102
parse-expected-name = expected { $what ->
    [function] a function name
    [variable] a variable name
    [parameter] a parameter name
    [field] a field name
    [attribute] an attribute name
    [struct] a structure name
    [enum] an enumeration name
    [variant] a variant name
    [type-parameter] a type parameter name
    [constraint] a constraint name
    [type] a type name
    [interface] an interface name
   *[other] a name
}, found { $eof ->
    [1] the end of the file
   *[other] `{ $found }`
}
parse-expected-name-label = a name is needed here
parse-expected-name-why = A name starts with a letter or `_`, followed by letters, digits or `_`. Keywords such as `fn`, `let` or `match` are reserved.
parse-expected-name-fix = write a name here
parse-expected-name-fix-keyword = `{ $keyword }` is a keyword: choose another name, e.g. `{ $keyword }_`

# E0103
parse-unclosed = unclosed `{ $open }`
parse-unclosed-open-label = `{ $open }` opened here
parse-unclosed-label = `{ $close }` expected here, before { $eof ->
    [1] the end of the file
   *[other] `{ $found }`
}
parse-unclosed-why = Every `(`, `[`, `{"{"}` and `<` needs its closing `)`, `]`, `{"}"}` or `>`; the parser reached the end of the construct first.
parse-unclosed-fix = close it with `{ $close }`

# E0104
parse-unexpected = unexpected { $eof ->
    [1] the end of the file
   *[other] `{ $found }`
}
parse-unexpected-label = this cannot appear here
parse-unexpected-expected-label = expected `{ $expected }`
parse-unexpected-separator-label = expected `,` or `{ $close }`
parse-unexpected-why = Each construct has a fixed shape, such as `fn name(parameter: Type): Type {"{"} … {"}"}` or `let name = value;`, and this token does not fit at this point.
parse-unexpected-fix = check this line for a missing operator, separator or bracket

# E0105
parse-expected-type = expected a type, found { $eof ->
    [1] the end of the file
   *[other] `{ $found }`
}
parse-expected-type-label = a type is needed here, e.g. `i32`
parse-expected-type-why = A type follows `:` in a parameter, a return type or an annotated variable: `i32`, `f64`, `bool`, `Array<f32>`, `Option<i32>`…
parse-expected-type-fix = write a type, e.g. `i32`

# E0106
parse-removed-keyword = `{ $keyword }` does not exist in Peras
parse-removed-keyword-label = write `{ $replacement }`
parse-removed-keyword-why = { $keyword ->
    [var] `var` is scoped to the whole function and can be declared twice; Peras only has `let` and `const`, scoped to their block.
   *[other] Peras declares functions with `fn`, which never has a dynamic `this`.
}
parse-removed-keyword-fix = replace `{ $keyword }` with `{ $replacement }`

# E0107
parse-number-too-large = number `{ $literal }` is too large
parse-number-too-large-int-label = does not fit in 64 bits
parse-number-too-large-float-label = is infinite as a 64-bit float
parse-number-too-large-why = The widest integers have 64 bits (`i64` up to 9223372036854775807, `u64` up to 18446744073709551615), and an `f64` cannot exceed about 1.8e308.
parse-number-too-large-fix = use a smaller value

# E0108
parse-chained-comparison = comparisons cannot be chained
parse-chained-comparison-first-label = first comparison
parse-chained-comparison-label = second comparison
parse-chained-comparison-why = In JavaScript, `a < b < c` compares the boolean result of `a < b` with `c`, which is almost never intended; Peras refuses it.
parse-chained-comparison-fix = compare each pair and join them with `&&`: `{ $suggestion }`
parse-chained-comparison-fix-mixed = split the expression with `&&`, or add parentheses to show what is compared

# E0109
parse-bitwise-mix = `{ $bitwise }` and `{ $comparison }` need parentheses
parse-bitwise-mix-label = bitwise operator
parse-bitwise-mix-comparison-label = comparison
parse-bitwise-mix-why = JavaScript reads `a & b == c` as `a & (b == c)`, because `&`, `|` and `^` bind more loosely than comparisons; that is rarely intended, so Peras makes you write the order.
parse-bitwise-mix-fix = add parentheses: `{ $suggestion }`

# E0110
parse-expected-item = expected a declaration, found { $eof ->
    [1] the end of the file
   *[other] `{ $found }`
}
parse-expected-item-label = only declarations can appear at the top level
parse-expected-item-why = A module holds declarations: `fn`, `struct`, `let` and `const`, optionally preceded by `export` or an attribute such as `@frame`. Statements go inside a function body.
parse-expected-item-fix = move this code into a function

# E0111
parse-too-deep = nesting is too deep
parse-too-deep-label = more than { $limit } levels deep
parse-too-deep-why = The parser stops at { $limit } levels of nested expressions or types, so that no file, even a hostile or generated one, can exhaust the compiler's stack.
parse-too-deep-fix = split the expression into named intermediate variables

# E0112
parse-const-without-value = `{ $keyword }` without a value
parse-const-without-value-label = `{ $name }` needs a value
parse-const-without-value-why = A `const` is given its value once, where it is declared, and never changes.
parse-const-without-value-fix = give it a value with `= …`, or declare it with `let` to assign it later

# E0113
parse-assignment-in-expression = an assignment is not an expression
parse-assignment-in-expression-label = `{ $operator }` assigns here
parse-assignment-in-expression-why = In Peras, an assignment is a statement of its own and has no value, so `if (a = b)` or `x = y = 0` cannot hide a mistake.
parse-assignment-in-expression-fix-compare = to compare, write `==`
parse-assignment-in-expression-fix = make the assignment a statement of its own, on its own line

# E0114
parse-invalid-target = cannot assign to this expression
parse-invalid-target-label = not a variable, a field or an element
parse-invalid-target-why = Only a variable (`x`), a field (`p.x`) or an element (`a[i]`) can be assigned, incremented or decremented.
parse-invalid-target-fix = assign to a variable, a field or an element instead

# E0115
parse-condition-parentheses = the condition of `{ $keyword }` needs parentheses
parse-condition-parentheses-label = this condition
parse-condition-parentheses-why = As in TypeScript, the condition of `if` and `while` is written in parentheses: `if (x > 0)`.
parse-condition-parentheses-fix = put the condition in parentheses

# E0116
parse-for-in = `for…in` does not exist in Peras
parse-for-in-label = write `of`
parse-for-in-why = In JavaScript, `for…in` walks the keys of an object, inherited ones included, as strings; Peras only has `for…of`, which walks the values of a collection.
parse-for-in-fix = replace `in` with `of`

# E0117
parse-jump-outside-loop = `{ $keyword }` outside a loop
parse-jump-outside-loop-label = no loop around this `{ $keyword }`
parse-jump-outside-loop-why = `{ $keyword }` only works inside `for` or `while`, in the same function.
parse-jump-outside-loop-fix = remove `{ $keyword }`, or use `return` to leave the function

# E0118
parse-optional-marker = `?:` does not exist in Peras
parse-optional-marker-label = optional marker
parse-optional-marker-why = Peras has no implicit `undefined` or `null`: a value that may be missing has the type `Option<T>`, and the compiler makes you handle both cases.
parse-optional-marker-fix = write the type `Option<{ $type }>`

# E0119
parse-empty-body = `;` right after `{ $keyword }` leaves it empty
parse-empty-body-label = this `;` ends the `{ $keyword }`
parse-empty-body-why = In JavaScript, `if (c); {"{"} … {"}"}` runs the block every time: the `;` is the whole body. Peras refuses this silent mistake; an intentionally empty body is written `{"{"}{"}"}`.
parse-empty-body-fix = remove the `;`, or write `{"{"}{"}"}` for an empty body

## Names and types (E0200–E0299)

check-did-you-mean = did you mean `{ $name }`?

# E0200
check-undefined = `{ $name }` is not defined
check-undefined-label = not found in this scope
check-undefined-why = A name must be declared before it is used, in this scope or an enclosing one: with `let`, `const`, `fn` or `struct`, or as a parameter.
check-undefined-fix = declare it, or check its spelling

# E0201
check-shadowing = `{ $name }` hides another declaration
check-shadowing-label = this `{ $name }` hides the other one
check-shadowing-previous-label = first declared here
check-shadowing-why = Peras refuses shadowing: two variables with the same name in nested scopes make it easy to read or change the wrong one.
check-shadowing-fix = give this `{ $name }` another name

# E0202
check-duplicate = `{ $name }` is declared twice
check-duplicate-label = declared again here
check-duplicate-previous-label = first declared here
check-duplicate-why = A name is declared once per scope: functions, structures and module constants share one namespace, and so do the fields of a structure and the parameters of a function.
check-duplicate-fix = rename or remove one of the two `{ $name }`

# E0203
check-unused = { $what ->
    [parameter] parameter
   *[other] variable
} `{ $name }` is never read
check-unused-label = never read
check-unused-why = A value that is never read is dead code, and often a bug: a typo, or a use that was forgotten. A name starting with `_` marks a parameter as unused on purpose.
check-unused-fix-parameter = if it is unused on purpose, name it `_{ $name }`
check-unused-fix-variable = remove it, or use its value

# E0204
check-moved = `{ $name }` is used after it was moved
check-moved-label = used here, after the move
check-moved-given-label = `{ $name }` receives its value here
check-moved-here-label = moved here
check-moved-loop-label = moved here in the previous turn of the loop
check-moved-why = A value on the heap, an array, a string, or a structure holding one, has a single owner. Assigning it, returning it or passing it to a `sink` parameter moves it: the old name holds nothing until it is given a new value.
check-moved-fix = give the variable a new value before it is used again
check-fix-copy = move a copy instead, with `.copy()`

# E0205
check-immutable = cannot modify { $kind ->
    [parameter] the parameter
   *[other] the constant
} `{ $name }`
check-immutable-label = modified here
check-immutable-declared-label = { $kind ->
    [parameter] read-only parameter
   *[other] declared with `const`
}
check-immutable-why = A `const` never changes, and a parameter is read-only unless it is passed `inout`, which shows the caller that the function modifies it.
check-immutable-fix-const = declare `{ $name }` with `let`
check-immutable-fix-parameter = pass `{ $name }` as `inout`

# E0206
check-inout-marker = { $kind ->
    [missing] an `inout` argument is written with `&`
   *[other] `&` marks `inout` arguments only
}
check-inout-marker-label = { $kind ->
    [missing] passed to an `inout` parameter without `&`
   *[other] this parameter is not `inout`
}
check-inout-marker-why = `&` at the call shows that the function may change the variable. It is required for an `inout` parameter, and refused anywhere else, so that it always means that.
check-inout-marker-fix-add = write `&` before the argument
check-inout-marker-fix-remove = remove the `&`

# E0207
check-alias = `{ $name }` is passed twice to `{ $callee }`, and one of them changes it
check-alias-label = reaches the same variable again
check-alias-other-label = first reached here
check-alias-why = An `inout` parameter changes its variable in place. Another argument reaching the same variable would see it change during the call, so Peras refuses it.
check-alias-fix = pass two different variables
check-alias-loop = `{ $name }` changes while a loop goes through it
check-alias-loop-label = changed here
check-alias-loop-iterated-label = the loop goes through it
check-alias-loop-fix = go through a copy, `{ $name }.copy()`, to change the original

# E0209
check-move-out = cannot move { $what ->
    [parameter] the parameter `{ $name }`, which only borrows its value
    [field] a field out of its structure
    [element] an element out of its array
    [binding] a value out of the `match` or the arrow function that only lends it
   *[other] a module-level value
}
check-move-out-label = moved here
check-move-out-why = Only the owner of a value can move it. A parameter that is not `sink` borrows the caller's value, and a field or an element belongs to what holds it.
check-move-out-fix = move a copy, with `.copy()`, or move the whole owner
check-move-out-fix-sink = declare `{ $name }` as `sink`: the function then takes the value

# E0210
check-mismatch = mismatched types: expected `{ $expected }`, found `{ $found }`
check-mismatch-label = this is `{ $found }`
check-mismatch-why = Peras never converts a value implicitly, not even between numbers: `i32 + f64` is an error, because a silent conversion can lose precision or overflow.
check-mismatch-fix-convert = convert it explicitly with `.{ $method }()`
check-mismatch-fix = use a value of type `{ $expected }`

# E0211
check-integer-for-float = integer literal where `{ $expected }` is expected
check-integer-for-float-label = `{ $literal }` is an integer
check-integer-for-float-why = An integer literal never becomes a float implicitly; the decimal point makes the intent visible.
check-integer-for-float-fix = write `{ $literal }`

# E0212
check-out-of-range = `{ $literal }` does not fit in `{ $type }`
check-out-of-range-label = `{ $type }` holds values from { $min } to { $max }
check-out-of-range-why = A literal is checked against its type at compile time, so that it never overflows or wraps around silently.
check-out-of-range-fix = use a value in range, or a wider type

# E0213
check-unknown-type = unknown type `{ $name }`
check-unknown-type-label = not a type
check-unknown-type-why = A type is either built in (`i32`, `f64`, `bool`, `String`, `Array<T>`, `Option<T>`…) or a `struct` declared in the module.
check-unknown-type-fix = declare a `struct` with this name, or use a built-in type

# E0214
check-argument-count = `{ $name }` takes { $expected ->
    [one] 1 argument
   *[other] { $expected } arguments
}, found { $found }
check-argument-count-label = { $found ->
    [one] 1 argument given
   *[other] { $found } arguments given
}
check-argument-count-declared-label = { $expected ->
    [one] takes 1 argument
   *[other] takes { $expected } arguments
}
check-argument-count-why = Every parameter receives exactly one argument, in order: Peras has no optional parameters and no implicit `undefined`.
check-argument-count-fix = pass exactly { $expected ->
    [one] 1 argument
   *[other] { $expected } arguments
}

# E0215
check-unknown-member = `{ $type }` has no field or method `{ $member }`
check-unknown-member-label = not a member of `{ $type }`
check-unknown-member-why = The fields of a structure come from its declaration; built-in types have a fixed set of members, such as `length` or `toF64()`.
check-unknown-member-fix = check the name of the field or method

# E0216
check-type-argument-count = `{ $name }` takes { $expected } type arguments, found { $found }
check-type-argument-count-label = expects { $expected }
check-type-argument-count-why = A type or a function takes as many type arguments as it has type parameters: one for `Array` and `Option`, as in `Array<f32>`, two for `Result`, the number declared for a generic one, and none for the others.
check-type-argument-count-fix = write `{ $name }` with { $expected } type arguments

# E0217
check-condition = condition of type `{ $found }`, expected `bool`
check-condition-label = this is `{ $found }`, not `bool`
check-condition-why = Peras has no truthiness: `0`, `""` and `None` are not false. A condition is a `bool`, so that its meaning is always explicit.
check-condition-fix-compare = compare explicitly: `{ $comparison }`
check-condition-fix = write a comparison that gives a `bool`

# E0218
check-return = { $kind ->
    [value] this function returns no value
   *[other] missing return value of type `{ $expected }`
}
check-return-label = { $kind ->
    [value] value returned here
   *[other] `return` without a value
}
check-return-declared-label = the function returns `{ $expected }`
check-return-why = A function returns exactly what its return type says: a value of that type on every `return`, or nothing when it is `void`.
check-return-fix = { $kind ->
    [value] remove the value, or declare a return type
   *[other] return a value of the declared type
}

# E0219
check-missing-return = `{ $name }` can end without returning a value
check-missing-return-label = the end of the function can be reached here
check-missing-return-declared-label = returns `{ $expected }`
check-missing-return-why = A function with a return type returns a value on every path; reaching the end of its body would return nothing.
check-missing-return-fix = end every path with a `return` of type `{ $expected }`

# E0220
check-missing-return-type = `{ $name }` has no return type
check-missing-return-type-label = { $reason ->
    [exported] an exported function declares its return type
   *[other] returns a value without declaring its type
}
check-missing-return-type-why = Public signatures are always written out, so a module's interface never depends on what its body happens to return; a function returning a value declares its type.
check-missing-return-type-fix = add the return type `{ $type }`

# E0221
check-operator = `{ $operator }` cannot be used on `{ $type }`
check-operator-label = this is `{ $type }`
check-operator-why = Each operator applies to specific types: arithmetic to numbers, `+` also to strings, `&`, `|`, `^`, `~`, `<<` and `>>` to integers, `!`, `&&` and `||` to `bool`, unary `-` to signed numbers, `[]` to arrays.
check-operator-fix = convert the value, or use another operation

## Code generation (E0900–E0999)

# E0222
check-match-missing = this `match` on `{ $ty }` does not cover { $missing }
check-match-missing-label = add an arm for { $missing }
check-match-missing-match-label = every value must reach an arm
check-match-missing-why = A `match` must handle every value it can receive: each variant of an enumeration or an option, `true` and `false`, and for numbers or strings a final `_`. Forgetting a case is the bug an exhaustive `match` exists to catch.
check-match-missing-fix = add the missing arms, or a final `_ => …` arm on purpose

# E0223
check-unknown-variant = `{ $ty }` has no variant `{ $name }`
check-unknown-variant-label = unknown variant
check-unknown-variant-why = The variants of an enumeration are the ones its declaration lists; an option has `None` and `Some`.
check-unknown-variant-fix = use one of the variants the declaration lists

# E0224
check-unreachable-arm = this arm can never be reached
check-unreachable-arm-label = earlier arms already cover these values
check-unreachable-arm-why = Arms are tried in order: after `_`, a name, or a variant already covered, no value is left for this one. It is dead code, or arms in the wrong order.
check-unreachable-arm-fix = remove the arm, or move it before the one that covers it

# E0225
check-try-return = `?` on { $kind ->
    [option] an option
   *[other] a result
} in a function that returns `{ $ret }`
check-try-return-label = returns early with { $kind ->
    [option] `None`
   *[other] the `Err`
}
check-try-return-why = `?` gives the value inside, or returns at once what it cannot give: `None` for an option, the error for a result. The function must be able to return that: an option, or a result with the same type of error.
check-try-return-fix = { $kind ->
    [option] return an `Option`, or handle `None` with `match` or `unwrapOr`
   *[other] return a `Result` with this type of error, or handle the error with `match`
}

# E0226
check-unknown-constraint = unknown constraint `{ $name }`
check-unknown-constraint-label = not a constraint
check-unknown-constraint-why = A type parameter is constrained by what its types must be able to do: `Eq` (`==`), `Ord` (comparisons), `Numeric` (arithmetic, for integers and floats), `Integer`, `Float`, or `Copy` (copied, not moved).
check-unknown-constraint-fix = use `Eq`, `Ord`, `Numeric`, `Integer`, `Float` or `Copy`

# E0227
check-constraint = `{ $ty }` is not `{ $bound }`
check-constraint-label = `{ $param }` is `{ $ty }` here
check-constraint-declared = `{ $param }` must be `{ $bound }`
check-constraint-why = A generic function or type works for every type that meets the constraints of its parameters, and only for those: its body relies on them, so a type that does not meet one would make it fail.
check-constraint-fix = give `{ $param }` a type that is `{ $bound }`

# E0228
check-missing-constraint = `{ $op }` on `{ $param }`, which may not support it
check-missing-constraint-label = `{ $op }` needs `{ $bound }`
check-missing-constraint-why = A generic body is checked once, for every type its parameters may stand for. Without a constraint, a type parameter can be any type, and not every type supports every operation; the constraint says it does, and each call is checked against it.
check-missing-constraint-fix = constrain the parameter: `{ $param }: { $bound }`

# E0229
check-cannot-infer = cannot tell which type `{ $param }` of `{ $name }` stands for
check-cannot-infer-label = `{ $param }` is unknown here
check-cannot-infer-declared = `{ $param }` declared here
check-cannot-infer-why = The type arguments of a generic function come from its arguments, or from the type the call must have. Here neither says what it is.
check-cannot-infer-fix = give the result a type, as in `let xs: Array<i32> = …`, or pass a value of type `{ $param }`

# E0230
check-generic-export = exported function `{ $name }` is generic
check-generic-export-label = exported, with type parameters
check-generic-export-why = Generic code is compiled once per set of type arguments the module uses. JavaScript calls an exported function with any value, so there is no single copy to export.
check-generic-export-fix = export a function that is not generic and calls `{ $name }` with the types needed

# E0231
check-endless-instances = `{ $name }` would need endless copies
check-endless-instances-label = instantiated with ever larger types
check-endless-instances-why = Each set of type arguments gives a copy of the generic code. Here a copy needs another with a larger type, as when `f<T>` calls `f<Array<T>>`, or a structure contains itself with a larger type argument: there is no end.
check-endless-instances-fix = use the same type parameters in the recursive call or field

# E0232
check-alias-cycle = type alias `{ $name }` contains itself
check-alias-cycle-label = refers to itself, directly or through other aliases
check-alias-cycle-why = An alias is another name for a type: replacing it by what it names must end. A type that contains itself needs a structure or an enumeration, whose size the compiler can compute.
check-alias-cycle-fix = make it a structure or an enumeration

# E0233
check-not-constant = the value of a module constant must be known when compiling
check-not-constant-label = computed when the program runs
check-not-constant-why = A module `const` is written into the code wherever it is used: its value is made of literals, other constants, operators, arrays, tuples, structures, options and variants. A call runs only when the program does.
check-not-constant-fix = compute it in a function, or write its value

# E0234
check-no-methods = `{ $ty }` cannot have methods here
check-no-methods-label = not a structure or an enumeration of this module
check-no-methods-why = An `impl` gives methods to a structure or an enumeration declared in the module. Other types have the built-in methods of the method reference.
check-no-methods-fix = wrap the value in a structure of the module, and give it the methods

# E0235
check-impl-missing = the implementation of `{ $interface }` for `{ $ty }` lacks { $missing }
check-impl-missing-label = missing { $missing }
check-impl-extra = `{ $name }` is not a method of `{ $interface }`
check-impl-extra-label = `{ $interface }` declares no such method
check-impl-mismatch = an implementation that does not match its interface
check-impl-mismatch-why = An `impl Interface for Type` provides exactly the methods the interface declares: code that relies on the interface calls each of them, and nothing else belongs there.
check-impl-missing-fix = add the missing methods, with the signatures `{ $interface }` declares
check-impl-extra-fix = move `{ $name }` into an `impl` of the type itself

# E0236
check-signature = `{ $name }` does not match `{ $interface }`
check-signature-label = expected `{ $expected }`
check-signature-declared = declared in `{ $interface }` here
check-interface-self = interface method `{ $name }` does not take `self`
check-interface-self-label = `self` must come first
check-signature-why = A method of an interface is called on a value of any type that implements it: it takes `self` first, and each implementation has exactly its parameters, their conventions and its return type.
check-signature-fix = write it `{ $expected }`
check-interface-self-fix = write `fn { $name }(self, …)`

# E0237
check-interface-as-type = interface `{ $name }` used as a type
check-interface-as-type-label = an interface, not a type
check-interface-as-type-why = An interface is a constraint: it says what a type can do, not which type a value has. Code that works for every type implementing it is generic, and compiled once per type, with no cost at run time.
check-interface-as-type-fix = use a type parameter: `fn f<T: { $name }>(x: T)`

# E0238
check-arrow = an arrow function is a value only in a managed module
check-arrow-label = not the argument of a method that takes a function
check-arrow-expected = this method takes an arrow function
check-arrow-expected-label = expected `(x) => …`
check-arrow-why = In an owned module, an arrow function is compiled in place, as the body of a loop, by the methods of arrays that take one: `map`, `filter`, `reduce`, `find`, `findIndex`, `some` and `every`. In a managed module, an arrow function is also a value: kept in a variable, passed to a function whose parameter has a function type, `(Event) => void`, and called; it sees the variables around it, and changes those declared with `let`. Its parameters then have their types written, since nothing else gives them, and a function type is written only for a variable, a parameter or a result, where the checker can follow it. An exported function cannot take or give one yet: the values a function of JavaScript returns would go unchecked.
check-arrow-fix = pass it to `map`, `filter`, `reduce`, `find`, `findIndex`, `some` or `every`, or write a function with `fn`
check-arrow-param = the type of `{ $name }` is not written
check-arrow-param-label = a parameter of an arrow function used as a value
check-arrow-param-fix = write its type: `({ $name }: Event) => …`
check-arrow-type = a function type cannot be written here
check-arrow-type-label = inside another type
check-arrow-type-fix = write a function type only for a variable, a parameter or a result
check-arrow-export = exported function `{ $name }` takes or gives a function
check-arrow-export-label = a function type, in an exported function
check-arrow-export-fix = keep the function to the module, and export one that takes data
check-arrow-expected-fix = write the function in place: `xs.map((x) => x * 2)`
check-template = a template literal cannot write a `{ $type }` as text yet
check-template-label = a `{ $type }`
check-template-why = A template literal writes each of its values as text: a string as it is, a number or a boolean as `toString()` writes it, as JavaScript does. A structure, an array or an option has no text of its own yet: which fields, in which order, is for the program to say.
check-template-fix = write its fields there, one value each
check-map-key = a `{ $type }` cannot be a map's key or a set's element yet
check-map-key-label = a `{ $type }` key
check-map-key-why = A map finds its keys by their hash and their equality, written in its runtime for integers, booleans and strings. A structure, an enumeration or a float needs a rule for both: a float, because `NaN` is not equal to itself and `-0` is equal to `+0`.
check-map-key-fix = use an integer, a boolean or a string as the key: an identifier, or a key built as text
check-parallel = this loop cannot run in parallel: { $reason ->
    [shape] a parallel loop is written `parallel for (let i = start; i < end; i++)`
    [outer] it assigns `{ $name }`, declared outside the loop
    [index] it writes an element at another index than its counter's
    [reads] it reads, at another index than its counter's, an array it writes
    [calls] it calls a function
    [heap] it makes, grows, moves or releases a string, an array or a map
    [exits] it leaves the loop with `break` or `return`
   *[other] its turns could see each other
}
check-parallel-label = turns that may run at the same time
check-parallel-why = The turns of a parallel loop run on several threads at once, in any order. Each turn may read anything the loop does not change, and write only the elements at its own index, so that no turn sees another: the results are then those of the loop run in order, bit for bit.
check-parallel-fix = keep in each turn only what reads the inputs and writes `xs[i]`; compute a sum or what needs memory in an ordinary loop after it

# E0242
check-managed-only = { $what ->
    [async] an `async` function
    [await] `await`
    [await-sync] `await` outside an `async` function
    [number] the type `number`
    [promise] the type `Promise`
    [import] an `import`
    [browser] the browser's API
    [extern] an `extern` block
    [arrow-block] an arrow function with statements
    [function-type] a function type
   *[other] this
} { $what ->
    [await-sync] cannot wait
   *[other] belongs to managed modules (`.apeiron`)
}
check-managed-only-label = { $what ->
    [await-sync] waits in a function that does not
   *[other] only in a `.apeiron` module
}
check-managed-only-why = An owned module (`.peras`) compiles to WebAssembly, where nothing waits: it computes and returns. A managed module (`.apeiron`) compiles to JavaScript, for what talks to the browser: it waits with `async` and `await`, counts with `number`, and calls owned modules by importing them. `await` waits for a promise, so only a function that gives a promise itself, an `async` one, may use it.
check-managed-only-fix = { $what ->
    [await-sync] mark the function `async`, and its result `Promise<T>`
    [number] use `f64`, which `number` names in a managed module
    [browser] use the browser in a `.apeiron` module, and give this module the data
   *[other] move this code to a `.apeiron` module, which may import this one
}

# E0243
check-owned-only = { $what ->
    [inout] `inout` on a value JavaScript copies
    [inout-assign] replacing an `inout` parameter
    [sink] `sink`
    [parallel] `parallel for`
   *[other] this
} belongs to owned modules (`.peras`)
check-owned-only-label = only in a `.peras` module
check-owned-only-why = A managed module's values belong to the JavaScript garbage collector: nothing moves and nothing is lent. An array, a map, a set or a structure is shared with the caller, so an `inout` one can be changed, and the caller sees it; a number, a boolean, a string or an option is copied, and an `inout` one could not reach its caller, nor could a parameter replaced by another value. Giving a value with `sink`, and loops that split work between threads over shared memory, are those of owned modules, compiled to WebAssembly.
check-owned-only-fix = { $what ->
    [parallel] write the loop in a `.peras` module and import its function
    [inout-assign] change its elements or fields, or return the new value
   *[other] remove the convention: return the new value instead of changing the argument
}

# E0244
check-import = { $reason ->
    [module] cannot import from `{ $name }`
    [name] `{ $name }` is not an exported function of this module
    [signature] `{ $name }` takes or gives a value that cannot cross between modules yet
   *[other] cannot import `{ $name }`
}
check-import-label = { $reason ->
    [module] not an owned module that compiles
    [name] not exported here
    [signature] imported here
   *[other] here
}
check-import-why = A managed module imports functions from owned modules (`.peras`), in the same folder or below it, and calls them through checked conversions: numbers, booleans, strings, and arrays, options, results, maps and sets of them cross between the two. A structure or an enumeration is the other module's own type, and does not cross yet.
check-import-fix = { $reason ->
    [module] import a `.peras` file by its relative path, such as `"./maths.peras"`, and fix its errors first
    [name] mark the function `export` in its module, or check its spelling
    [signature] give the function numbers, strings, or arrays of them, and build the structure on each side
   *[other] check the import
}

# E0245
check-resource = { $reason ->
    [dropped] this resource is released as soon as it is made
    [moved] `{ $name }` is used after it was given away
    [loop] `{ $name }` is given away in a loop
    [capture] `{ $name }` is a resource, and an arrow function cannot keep it
    [holder] a resource cannot be kept in a structure, an array, an option or a map
    [lent] `{ $name }` is lent to this function, which cannot give it away
    [reassign] `{ $name }` is lent to this function, which cannot replace it
    [global] `{ $name }` is a module variable: nothing would release the resource it holds
   *[other] this resource cannot be used here
}
check-resource-label = { $reason ->
    [dropped] made here, kept by nothing
    [moved] used here
    [loop] given away at each turn
    [capture] kept by the arrow function
    [holder] kept here
    [lent] given away here
    [reassign] replaced here
    [global] kept for as long as the page
   *[other] here
}
check-resource-why = A listener, a timer and a group are resources: each belongs to one variable, and is released when that variable goes out of scope, so that nothing keeps listening or ticking after its owner is gone. A resource can be given away once: returned, added to a `Group`, set in a `Slot`, or released with `release()`; after that, its variable holds nothing. Replacing the resource of a `let` variable releases the one it held. One that nothing keeps would be released at once, and one kept by a structure, an array or an arrow function would have no owner to release it.
check-resource-fix = { $reason ->
    [dropped] keep it in a variable, `const listener = …`, add it to a `Group`, or return it
    [moved] give it away last, or keep it in a `Group` and use the group
    [loop] add each one to a `Group` declared before the loop
    [capture] keep it in a `Slot` of a group, which an arrow function can use: `const pending = group.slot();`, then `pending.set(…)`
    [holder] keep it in a variable or a `Group`
    [lent] return it from the function that made it, or add it to a `Group` there
    [reassign] return the new resource, or keep the resource in a `Slot` of a group: `slot.set(…)` replaces it
    [global] keep it in a function that returns it, or in a `Group` that one returns
   *[other] keep the resource in a variable
}

# E0246
check-read-only = `{ $member }` of `{ $type }` can only be read
check-read-only-label = assigned here
check-read-only-why = The browser sets this property itself: an event's type and key, the status of a response, the body of a page. A page cannot change it.
check-read-only-fix = read it into a variable of your own, and change that one

# E0247
check-extern = { $reason ->
    [resource] `{ $name }` would give a resource to JavaScript, which cannot release it
    [callback] a function type is only allowed for a parameter of an `extern` function
    [self] `self` must be of a type this `extern` block declares
    [async] `{ $name }` is `async`: its result must be a `Promise`
   *[other] this `extern` declaration cannot be kept
}
check-extern-label = { $reason ->
    [resource] a resource here
    [callback] a function type here
    [self] not a type of this block
    [async] not a `Promise`
   *[other] here
}
check-extern-why = An `extern` block declares JavaScript a managed module calls, with Peras types: at each call, every value JavaScript gives back is checked against them. A resource belongs to one variable of Peras, which releases it: JavaScript would keep it without releasing it. A function type at the top of a parameter is a callback, which Peras gives and JavaScript calls; inside another type, or as a result, it would be a function of JavaScript whose values nothing checks. A method is declared with `self` of a type of the block, the values JavaScript makes. An `async` function gives a promise.
check-extern-fix = { $reason ->
    [resource] give JavaScript the data instead, and keep the resource in Peras
    [callback] declare the callback as a parameter of an `extern` function, and pass an arrow function there
    [self] declare the type in this block, `type Chart;`, and write `self: Chart`
    [async] declare its result as `Promise<T>`
   *[other] check the declaration
}

# E0248
check-floating-promise = this promise is never awaited
check-floating-promise-label = runs later, and nothing waits for it
check-floating-promise-why = Calling an `async` function starts its work and gives a promise of its result. Without `await`, the statements after the call run before that work is done, and an error it throws is lost. Forgetting `await` is one of the commonest bugs of asynchronous code.
check-floating-promise-fix = write `await` before the call, in an `async` function; to let it run on purpose, keep it: `const _saving = save();`

# E0249
check-sort-key = an array cannot be sorted by a `{ $type }`
check-sort-key-label = a `{ $type }`, not a number or a string
check-sort-key-why = `sortBy` and `sortByDescending` compute a key once per element, then sort the keys: numbers in the order of `sort()`, -0 before +0 and NaN last, strings in the order of their Unicode code points. Both modes sort them without calling a function at each comparison, in time proportional to the length for numbers. A key of another type has no order of its own: which field first, in which order, is for the program to say.
check-sort-key-fix = sort by a number or a string: a field, `(o) => o.amount`, or a key built as text

# E0900
gen-unsupported = code generation does not support { $feature ->
    [struct] structures
    [global] module-level constants and variables
    [inout] `inout` parameters
    [for-of] `for…of` loops
    [place] assignments to fields and elements
    [function-value] functions used as values
    [borrow] the borrow operator `&`
    [float-remainder] `%` on floats
    [string] strings
    [array] arrays
    [array-element] arrays of anything but numbers and booleans
    [heap-option] options holding an array or a string
    [inout-string] `inout` strings in exported functions, which JavaScript cannot change
    [inout-export] `inout` numbers and options in exported functions: JavaScript passes them by value
    [deep-equality] `==` on arrays of strings or of arrays
    [field] fields
    [index] indexing
    [try] the `?` operator
    [option] `Option` values
    [method] this method
    [integer-type] integer types other than `i32` and `i64`
    [reduce-heap] `reduce` with an accumulator holding a string or an array
    [recursive-type] types that contain themselves
    [map-value] maps whose values have more than 24 scalars
    [nested-option] in a managed module, options of options, whose `Some(None)` JavaScript cannot tell from `None`
   *[other] this construct
} yet
gen-unsupported-label = valid Peras, not compiled yet
gen-unsupported-why = The program is correct: the checks accepted it. Code generation is built step by step and, for now, handles `i32`, `i64`, `f32`, `f64` and `bool`, structures, options, and arrays of numbers and booleans, with every statement, calls and conversions.
gen-unsupported-fix = use only the supported constructs in this module for now, or keep it to `perasc check`

## Diagnostic rendering

diag-error = error
diag-why = why
diag-fix = fix
diag-details = details

## Runtime: memory bugs caught by the debug allocator
# Filled in by the generated JavaScript: { $alloc } and { $release } are sites,
# such as `f (alloc 1)`; { $count } and { $size } are numbers.

runtime-out-of-memory = out of memory: the block allocated at { $alloc } does not fit
runtime-too-large = { $alloc } asks for { $size } bytes at once, more than 1 GiB
runtime-overflow = bytes were written past the end of the block allocated at { $alloc }; seen when { $release } released it
runtime-invalid-release = { $release } releases something that is not a live block
runtime-double-release = the block allocated at { $alloc } is released a second time, at { $release }
runtime-use-after-release = the block allocated at { $alloc } was written after { $release } released it
runtime-leak = { $count } block(s) still alive at the end; the first was allocated at { $alloc }
runtime-index = index { $index } is out of bounds: the length is { $length }
runtime-integer-overflow = an integer overflowed: its type cannot hold the result. To wrap on purpose, use `wrappingAdd`, `wrappingSub` or `wrappingMul`; a production build wraps
runtime-simd = this module uses WebAssembly SIMD, which this browser does not have: Chrome or Edge 91, Firefox 89 and Safari 16.4 do. Build it with `--simd off` to load it everywhere.
