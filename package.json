{
  "name": "peras-workspace",
  "private": true,
  "type": "module",
  "description": "JS tooling for the Peras language: Vite plugin, Vitest adapter, project scaffolding.",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "bootstrap": "sh scripts/bootstrap.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "audit": "pnpm audit --audit-level low",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:i18n && pnpm run audit"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
