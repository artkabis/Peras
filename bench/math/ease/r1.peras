// R1 of decision 0035: a distance and an angle, as JavaScript writes them.
export fn r1(x1: f64, y1: f64, x2: f64, y2: f64): String {
  const dx = x2 - x1;
  const dy = y2 - y1;
  const distance = Math.sqrt(dx * dx + dy * dy);
  const angle = Math.atan2(dy, dx) * 180 / Math.PI;
  return `${distance.toFixed(2)} ${angle.toFixed(1)}`;
}
