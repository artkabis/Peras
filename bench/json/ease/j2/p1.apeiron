// P1 of decision 0038, option j2: settings read from a text into a
// structure, through a `Json` value read field by field.
struct Server {
  host: String,
  port: i32,
}

enum Theme {
  Light,
  Dark,
}

struct Settings {
  title: String,
  retries: i32,
  theme: Theme,
  servers: Array<Server>,
  proxy: Option<String>,
}

fn text(j: Json, at: String, key: String): Result<String, String> {
  const v = j.get(key);
  if (v.isNone()) {
    return Err(`${at}${key}: expected a value, found nothing`);
  }
  const s = v.asText();
  if (s.isNone()) {
    return Err(`${at}${key}: expected a string`);
  }
  return Ok(s);
}

fn int(j: Json, at: String, key: String): Result<i32, String> {
  const v = j.get(key);
  if (v.isNone()) {
    return Err(`${at}${key}: expected a value, found nothing`);
  }
  const n = v.asNumber();
  if (n.isNone()) {
    return Err(`${at}${key}: expected a number`);
  }
  if (n != n.floor() || n < -2147483648.0 || n > 2147483647.0) {
    return Err(`${at}${key}: expected an integer`);
  }
  return Ok(n.toI32());
}

fn server(j: Json, i: i32): Result<Server, String> {
  const at = `servers[${i}].`;
  const host = text(j, at, "host")?;
  const port = int(j, at, "port")?;
  return Ok(Server(host, port));
}

fn read(t: String): Result<Settings, String> {
  const j = Json.parse(t)?;
  const title = text(j, "", "title")?;
  const retries = int(j, "", "retries")?;
  const name = text(j, "", "theme")?;
  let theme = Theme.Light;
  if (name == "Dark") {
    theme = Theme.Dark;
  } else if (name != "Light") {
    return Err(`theme: expected Light or Dark, found ${name}`);
  }
  const list = j.get("servers").unwrapOr(Json.Null).asList();
  if (list.isNone()) {
    return Err("servers: expected an array");
  }
  let servers: Array<Server> = [];
  for (let i = 0; i < list.length; i++) {
    servers.push(server(list[i], i)?);
  }
  const p = j.get("proxy").unwrapOr(Json.Null);
  let proxy: Option<String> = None;
  if (!p.isNull()) {
    proxy = p.asText();
  }
  return Ok(Settings(title, retries, theme, servers, proxy));
}

export fn describe(t: String): String {
  match (read(t)) {
    Ok(s) => {
      return `${s.title}: ${s.servers.length} servers, ${s.retries} retries`;
    }
    Err(e) => {
      return `invalid: ${e}`;
    }
  }
}
