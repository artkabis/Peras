// P3 of decision 0038, option j2: a summary written as JSON, built as a
// `Json` value.
fn pair(country: String, category: String, count: i32): Json {
  let o: Map<String, Json> = Map.new();
  o.set("country", Json.Text(country));
  o.set("category", Json.Text(category));
  o.set("count", Json.Number(count.toF64()));
  return Json.Object(o);
}

export fn summary(rows: i32): String {
  let o: Map<String, Json> = Map.new();
  o.set("rows", Json.Number(rows.toF64()));
  o.set("total", Json.Number(rows.toF64() * 1.5));
  o.set("pairs", Json.List([pair("FR", "books", rows / 2), pair("JP", "games", rows - rows / 2)]));
  o.set("countries", Json.List([Json.Text("FR"), Json.Text("JP")]));
  return Json.Object(o).toText();
}
