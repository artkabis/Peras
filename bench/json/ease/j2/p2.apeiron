// P2 of decision 0038, option j2: records read from a text, one field
// summed, through a `Json` value.
export fn total(text: String): number {
  match (Json.parse(text)) {
    Ok(j) => {
      const items = j.get("items").unwrapOr(Json.Null).asList();
      if (items.isNone()) {
        return -1.0;
      }
      let sum = 0.0;
      for (const item of items) {
        const price = item.get("price").unwrapOr(Json.Null).asNumber();
        if (price.isNone()) {
          return -1.0;
        }
        sum += price;
      }
      return sum;
    }
    Err(e) => {
      return -1.0;
    }
  }
}
