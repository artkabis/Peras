// W1 of decision 0039 (t1): durations added and compared.
export fn spread(n: i32): f64 {
  let total = Duration.ms(0);
  let over = 0;
  for (let i = 0; i < n; i++) {
    const d = Duration.ms((i % 1000).toF64() * 1.5);
    total = total + d;
    if (d > Duration.ms(700)) {
      over += 1;
    }
  }
  return total.toMs() + over.toF64();
}
