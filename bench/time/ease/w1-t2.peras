// W1 of decision 0039 (t2): durations added and compared.
export fn spread(n: i32): f64 {
  let total = 0ms;
  let over = 0;
  for (let i = 0; i < n; i++) {
    const d = Duration.ms((i % 1000).toF64() * 1.5);
    total = total + d;
    if (d > 700ms) {
      over += 1;
    }
  }
  return total.toMs() + over.toF64();
}
