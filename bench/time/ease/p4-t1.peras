// P4 of decision 0039 (t1), an owned module: the total length of a
// playlist, its tracks in seconds, in minutes.
struct Track {
  title: String,
  seconds: f64,
}

export fn total(tracks: Array<Track>): f64 {
  let sum = Duration.ms(0);
  for (const t of tracks) {
    sum = sum + Duration.seconds(t.seconds);
  }
  return sum.toMinutes();
}
