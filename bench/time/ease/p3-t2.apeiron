// P3 of decision 0039 (t2): a countdown, "2 h 05 min", from a duration.
export fn countdown(left: Duration): String {
  const minutes = left.toMinutes().floor().toI32();
  const h = minutes / 60;
  const m = minutes % 60;
  if (m < 10) {
    return `${h} h 0${m} min`;
  }
  return `${h} h ${m} min`;
}
