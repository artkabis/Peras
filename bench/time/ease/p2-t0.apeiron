// P2 of decision 0039 (t0): the time a computation took, in milliseconds
// with one decimal.
fn work(n: i32): i32 {
  let s = 0;
  for (let i = 0; i < n; i++) {
    s = s.wrappingAdd(i * i);
  }
  return s;
}

export fn timed(n: i32): String {
  const start = now();
  const s = work(n);
  const took = now() - start;
  return `${s}: ${took.toFixed(1)} ms`;
}
