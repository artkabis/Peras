// P2 of decision 0032: a binary search tree built from a list of numbers,
// then summed: a type that holds itself (finding F310), as JavaScript
// writes it, `node.left = insert(node.left, value)`.

struct Node {
  value: i32;
  left: Option<Rc<Node>>;
  right: Option<Rc<Node>>;
}

fn insert(node: Option<Rc<Node>>, value: i32): Option<Rc<Node>> {
  if (node.isNone()) {
    return Some(Rc.new(Node(value, None, None)));
  }
  let n = node;
  if (value < n.value) {
    n.left = insert(n.left, value);
  } else {
    n.right = insert(n.right, value);
  }
  return Some(n);
}

fn sum(node: Option<Rc<Node>>): i64 {
  if (node.isNone()) {
    return 0;
  }
  return node.value.toI64() + sum(node.left) + sum(node.right);
}

export fn p2(values: Array<i32>): i64 {
  let root: Option<Rc<Node>> = None;
  for (const value of values) {
    root = insert(root, value);
  }
  return sum(root);
}
