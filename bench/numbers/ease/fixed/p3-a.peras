// P3 (decision 0030): a step of particles, slowed and bounced off the walls
// Fixed until it builds with option a.
// at 0 and 1, as a user writes it from JavaScript.
export fn step(pos: inout Array<f64>, speed: inout Array<f64>, dt: f64): f64 {
  let energy = 0.0;
  for (let i = 0; i < pos.length; i++) {
    speed[i] *= 0.99;
    pos[i] += speed[i] * dt;
    if (pos[i] < 0.0) {
      pos[i] = -pos[i];
      speed[i] = -speed[i];
    } else if (pos[i] > 1.0) {
      pos[i] = 2.0 - pos[i];
      speed[i] = -speed[i];
    }
    energy += speed[i] * speed[i] / 2.0;
  }
  return energy;
}
