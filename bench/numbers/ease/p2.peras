// P2 (decision 0030): the mean and the standard deviation of samples, as a
// user writes them from JavaScript.
export fn spread(xs: Array<f64>): f64 {
  let sum = 0.0;
  for (const x of xs) {
    sum += x;
  }
  const mean = sum / xs.length;
  let squares = 0.0;
  for (const x of xs) {
    squares += (x - mean) * (x - mean);
  }
  if (xs.length < 2) {
    return 0;
  }
  return (squares / (xs.length - 1)).sqrt() + mean;
}
