// The sorting benchmark (scripts/bench-sort.mjs): records made from a random
// sequence, then sorted by a number or by a string. The same source compiles
// as a managed module and, copied to a `.peras` file, as an owned one; the
// script times `made` alone and subtracts it, so that only the sort counts.
struct Rec {
  id: i32,
  amount: f64,
  name: String,
}

fn records(n: i32): Array<Rec> {
  let xs: Array<Rec> = [];
  let s = 17;
  for (let i = 0; i < n; i++) {
    s = s.wrappingMul(1103515245).wrappingAdd(12345);
    const r = ((s / 65536) % 100000).abs();
    xs.push(Rec(i, r.toF64() * 0.01, `c${r % 5000}`));
  }
  return xs;
}

fn checksum(xs: Array<Rec>): i32 {
  let check = 0;
  for (const x of xs) {
    check = check.wrappingMul(31).wrappingAdd(x.id);
  }
  return check;
}

export fn made(n: i32): i32 {
  return checksum(records(n));
}

export fn byAmount(n: i32): i32 {
  let xs = records(n);
  xs.sortBy((x) => x.amount);
  return checksum(xs);
}

export fn byAmountDown(n: i32): i32 {
  let xs = records(n);
  xs.sortByDescending((x) => x.amount);
  return checksum(xs);
}

export fn byName(n: i32): i32 {
  let xs = records(n);
  xs.sortBy((x) => x.name);
  return checksum(xs);
}
