
test "the first of each key is kept" {
  expect(firstOfEach([Row("a", 1), Row("b", 2), Row("a", 3)]) == [1, 2]).toBe(true);
  expect(firstOfEach([]) == []).toBe(true);
  expect(firstOfEach([Row("x", 5)]) == [5]).toBe(true);
  expect(firstOfEach([Row("a", 1), Row("a", 2), Row("a", 3)]) == [1]).toBe(true);
  expect(firstOfEach([Row("a", 1), Row("b", 2), Row("c", 3)]) == [1, 2, 3]).toBe(true);
  expect(firstOfEach([Row("b", 1), Row("a", 2), Row("b", 3), Row("a", 4)]) == [1, 2]).toBe(true);
}
