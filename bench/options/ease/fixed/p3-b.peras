// P3: a function that returns early when a lookup finds nothing.
fn price(prices: Map<String, i32>, item: String): i32 {
  const p = match (prices.get(item)) {
    Some(v) => v,
    None => {
      return -1;
    },
  };
  return p * 2;
}

export fn p3(item: String): i32 {
  let prices: Map<String, i32> = Map.new();
  prices.set("tea", 3);
  return price(prices, item);
}
