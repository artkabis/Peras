struct Row {
  name: String;
  qty: i32;
}

fn parse(i: i32): Option<Row> {
  if (i % 10 == 9) {
    return None;
  }
  return Some(Row(`r${i % 100}`, i % 7));
}

// W2 as option 2a asks: a test, then a placeholder never used.
export fn w2(n: i32): i32 {
  let total = 0;
  for (let i = 0; i < n; i++) {
    const row = parse(i);
    if (row.isNone()) {
      continue;
    }
    const r = row.unwrapOr(Row("", 0));
    total = (total + r.qty + r.name.length) % 1000003;
  }
  return total;
}
