// W3: a lookup with a string made at each call as its fallback, found nine
// times in ten (options 3a, 3b).
export fn w3(n: i32): i32 {
  let names: Map<i32, String> = Map.new();
  for (let k = 0; k < 900; k++) {
    names.set(k, `name${k}`);
  }
  let total = 0;
  for (let i = 0; i < n; i++) {
    const id = ((i % 1000) * 7919) % 1000;
    const label = names.get(id).unwrapOr(`unknown ${id}`);
    total = (total + label.length) % 1000003;
  }
  return total;
}
