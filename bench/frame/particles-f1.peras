// Decision 0047, A3 with f1: decision 0046's particle scene, its frame one
// `u32` a pixel, `r | g << 8 | b << 16 | a << 24`, cleared as words.

struct Particle {
  x: f64;
  y: f64;
  vx: f64;
  vy: f64;
  life: i32;
  hue: f64;
}

struct Scene {
  width: i32;
  height: i32;
  particles: Array<Particle>;
  pixels: Array<u32>;
  seed: f64;
}

impl Scene {
  fn new(width: i32, height: i32): Self {
    let pixels: Array<u32> = [];
    for (let i = 0; i < width * height; i++) {
      pixels.push(0);
    }
    return Scene(width, height, [], pixels, 1);
  }

  fn random(inout self): f64 {
    self.seed = (self.seed * 1103515245 + 12345) % 2147483648;
    return self.seed / 2147483648;
  }

  fn step(inout self) {
    for (let i = 0; i < 40; i++) {
      const vx = (self.random() - 0.5) * 4;
      const vy = -2 - self.random() * 4;
      const life = (60 + Math.floor(self.random() * 60)).toI32();
      const hue = self.random();
      self.particles.push(
        Particle(self.width.toF64() / 2.0, (self.height - 1).toF64(), vx, vy, life, hue),
      );
    }
    const cell = 8;
    const cols = Math.ceil(self.width.toF64() / cell.toF64());
    let grid: Map<i32, Array<i32>> = Map.new();
    for (let i = 0; i < self.particles.length; i++) {
      // `let p = self.particles[i]` would change a copy: E0205's fix, `let`,
      // built a program whose particles never died (F122).
      self.particles[i].vy += 0.08;
      self.particles[i].x += self.particles[i].vx;
      self.particles[i].y += self.particles[i].vy;
      if (self.particles[i].x < 0 || self.particles[i].x >= self.width.toF64()) {
        self.particles[i].vx = -self.particles[i].vx;
      }
      if (self.particles[i].y >= self.height.toF64()) {
        self.particles[i].y = (self.height - 1).toF64();
        self.particles[i].vy = -self.particles[i].vy * 0.6;
      }
      self.particles[i].life -= 1;
      const key = Math.floor(self.particles[i].y / cell.toF64()) * cols +
        Math.floor(self.particles[i].x / cell.toF64());
      let list = grid.get(key.toI32()).unwrapOr([]);
      list.push(i);
      grid.set(key.toI32(), list);
    }
    for (const entry of grid) {
      const list = entry.1.copy();
      if (list.length < 2) {
        continue;
      }
      for (const i of list) {
        self.particles[i].vx *= 0.98;
        self.particles[i].life -= 1;
      }
    }
    // `self.particles = self.particles.filter(…)` is valid Peras, not
    // compiled for a field of `inout self` (E0900 at build, F121): the
    // array is compacted in place.
    let kept = 0;
    for (let i = 0; i < self.particles.length; i++) {
      if (self.particles[i].life > 0) {
        self.particles[kept] = self.particles[i];
        kept += 1;
      }
    }
    while (self.particles.length > kept) {
      self.particles.pop();
    }
    self.draw();
  }

  fn draw(inout self) {
    for (let i = 0; i < self.pixels.length; i++) {
      self.pixels[i] = 0;
    }
    for (const p of self.particles) {
      const x = Math.floor(p.x);
      const y = Math.floor(p.y);
      if (x < 0 || y < 0 || x >= self.width.toF64() || y >= self.height.toF64()) {
        continue;
      }
      const o = (y * self.width.toF64() + x).toI32();
      const bright = Math.min(1.0, p.life.toF64() / 60.0);
      const r = clamp8(255 * bright).toU32();
      const g = clamp8(160 * p.hue * bright).toU32();
      self.pixels[o] = r | (g << 8) | (60 << 16) | (255 << 24);
    }
  }
}

// What a `Uint8ClampedArray` stores: clamped to 0 to 255, rounded to the
// nearest, a half to the even.
fn clamp8(v: f64): u8 {
  const c = v.clamp(0.0, 255.0);
  const f = Math.floor(c);
  const d = c - f;
  let r = f;
  if (d > 0.5 || (d == 0.5 && f % 2 == 1)) {
    r = f + 1;
  }
  return r.toU8();
}

export fn run(frames: i32): String {
  let scene = Scene.new(320, 200);
  for (let f = 0; f < frames; f++) {
    scene.step();
  }
  let sum = 0.0;
  for (let i = 0; i < scene.pixels.length; i++) {
    const w = scene.pixels[i];
    sum = (sum * 31 + (w & 255).toF64()) % 1000000007;
    sum = (sum * 31 + ((w >> 8) & 255).toF64()) % 1000000007;
    sum = (sum * 31 + ((w >> 16) & 255).toF64()) % 1000000007;
    sum = (sum * 31 + (w >> 24).toF64()) % 1000000007;
  }
  return `${scene.particles.length}|${sum}`;
}
