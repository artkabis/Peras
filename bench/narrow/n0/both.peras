// Decision 0045, N3: two values that must both be there, written as Peras
// asks today (n0).

fn add(a: Option<i32>, b: Option<i32>): i32 {
  if (a.isNone()) {
    return -1;
  }
  if (b.isNone()) {
    return -1;
  }
  return a + b;
}

export fn run(n: i32): i32 {
  let total = 0;
  for (let i = 0; i < n; i++) {
    let a: Option<i32> = None;
    let b: Option<i32> = None;
    if (i % 3 != 0) {
      a = Some(i & 1023);
    }
    if (i % 5 != 0) {
      b = Some(i & 511);
    }
    total = total.wrappingAdd(add(a, b));
  }
  return total;
}
