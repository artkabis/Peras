// Decision 0045, N1: a walk up the parents, ended by a parent missing or
// removed, written as Peras asks today (n0).

fn depth(parents: Array<Option<i32>>, alive: Array<bool>, at: i32): i32 {
  let d = 0;
  let h = at;
  while (true) {
    const p = parents[h];
    if (p.isNone()) {
      break;
    }
    if (!alive[p]) {
      break;
    }
    d += 1;
    h = p;
  }
  return d;
}

export fn run(n: i32): i32 {
  let parents: Array<Option<i32>> = [None];
  let alive: Array<bool> = [true];
  let seed = 7;
  for (let i = 1; i < n; i++) {
    seed = seed.wrappingMul(1103515245).wrappingAdd(12345);
    parents.push(Some(((seed >> 8) & 2147483647) % i));
    alive.push(i % 5 != 3);
  }
  let total = 0;
  for (let i = 0; i < n; i++) {
    total += depth(parents, alive, i);
  }
  return total;
}
