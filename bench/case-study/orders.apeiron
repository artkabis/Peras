// The case study, in a managed Peras module: the same table of orders as
// orders.ts, written as close as Peras allows (decision 0011).
struct Order {
  id: i32,
  customer: String,
  amount: number,
  paid: bool,
}

struct Summary {
  count: i32,
  total: number,
  unpaid: i32,
  top: String,
}

export fn summarize(orders: Array<Order>): Summary {
  let byCustomer: Map<String, number> = Map.new();
  let total = 0.0;
  let unpaid = 0;
  for (const o of orders) {
    total += o.amount;
    if (!o.paid) {
      unpaid += 1;
    }
    byCustomer.set(o.customer, byCustomer.get(o.customer).unwrapOr(0.0) + o.amount);
  }
  let top = "";
  let best = -1.0;
  for (const entry of byCustomer) {
    if (entry.1 > best) {
      best = entry.1;
      top = entry.0;
    }
  }
  return Summary(orders.length, total, unpaid, top);
}

export fn visible(orders: Array<Order>, text: String, up: bool): Array<Order> {
  const q = text.trim().toLowerCase();
  let kept = orders.filter((o) => o.customer.toLowerCase().includes(q));
  if (up) {
    kept.sortBy((o) => o.amount);
  } else {
    kept.sortByDescending((o) => o.amount);
  }
  return kept;
}

// The state belongs to each table: arrow functions capture it, so the
// table can be shown more than once in a page.
export fn mount(root: Element, orders: Array<Order>): Group {
  let group = Group.new();
  const input = document.createElement("input");
  const sortButton = document.createElement("button");
  sortButton.textContent = "Sort by amount";
  const summary = document.createElement("p");
  const list = document.createElement("ul");
  root.append(input);
  root.append(sortButton);
  root.append(summary);
  root.append(list);

  let query = "";
  let ascending = false;

  const render = () => {
    const rows = visible(orders, query, ascending);
    list.textContent = "";
    for (const o of rows) {
      const li = document.createElement("li");
      let label = `#${o.id} ${o.customer} ${o.amount.toFixed(2)}`;
      if (!o.paid) {
        label += " (unpaid)";
      }
      li.textContent = label;
      list.append(li);
    }
    const s = summarize(rows);
    summary.textContent = `${s.count} orders, ${s.total.toFixed(2)} total, ${s.unpaid} unpaid, top: ${s.top}`;
  };

  // The search waits for the user to stop typing: the slot holds one timer,
  // and each keystroke replaces it, releasing the one before.
  const pending = group.slot();
  match (input.asInput()) {
    Some(field) => {
      group.add(field.on("input", (_e) => {
        pending.set(setTimeout(50, () => {
          query = field.value;
          render();
        }));
      }));
    }
    None => {}
  }
  group.add(sortButton.on("click", (_e) => {
    ascending = !ascending;
    render();
  }));
  render();
  return group;
}
