// Decision 0044, W3, a budget of chunks, written for p0: at most 256 chunks
// of 4 KiB kept, each in a slot; a path of steps asks for the chunk of
// each place it crosses, and when the budget is full the chunk used least
// recently gives its slot to the next one.

struct Chunk {
  key: i32;
  used: i32;
  bytes: Array<u8>;
}

fn load(key: i32): Array<u8> {
  let bytes: Array<u8> = [];
  for (let i = 0; i < 4096; i++) {
    bytes.push(((key * 31 + i) & 255).toU8());
  }
  return bytes;
}

export fn run(steps: i32): i32 {
  let chunks: Array<Chunk> = [];
  let where: Map<i32, i32> = Map.new();
  let x = 0;
  let y = 0;
  let seed = 3;
  let sum = 0;
  let misses = 0;
  for (let t = 0; t < steps; t++) {
    seed = seed.wrappingMul(1103515245).wrappingAdd(12345);
    const dir = (seed >> 16) & 3;
    if (dir == 0) {
      x += 1;
    } else if (dir == 1) {
      x -= 1;
    } else if (dir == 2) {
      y += 1;
    } else {
      y -= 1;
    }
    const key = (x >> 3) * 4096 + (y >> 3);
    let slot = where.get(key).unwrapOr(-1);
    if (slot < 0) {
      misses += 1;
      if (chunks.length < 256) {
        slot = chunks.length;
        chunks.push(Chunk(key, t, load(key)));
      } else {
        slot = 0;
        for (let i = 1; i < chunks.length; i++) {
          if (chunks[i].used < chunks[slot].used) {
            slot = i;
          }
        }
        where.delete(chunks[slot].key);
        chunks[slot] = Chunk(key, t, load(key));
      }
      where.set(key, slot);
    }
    chunks[slot].used = t;
    sum += chunks[slot].bytes[t & 4095].toI32();
  }
  return sum + misses;
}
