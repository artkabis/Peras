// W3: a closure returned by a function, then given to `map`.
fn label(prefix: String): (String) => String {
  return (s: String): String => `${prefix}${s}`;
}

export fn w3(count: i32): i32 {
  let words: Array<String> = [];
  for (let i = 0; i < count; i++) {
    words.push(`item-${i % 100000}`);
  }
  const f = label("pre:");
  const out = words.map(f);
  let total = 0;
  for (const o of out) {
    total += o.length;
  }
  return total;
}
