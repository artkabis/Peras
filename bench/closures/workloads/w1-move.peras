// W1 under option A: the string moves into each closure, so each turn
// copies it first, written by the program.
fn apply(f: (i32) => i32, x: i32): i32 {
  return f(x);
}

export fn w1(size: i32, times: i32): i32 {
  const s = "a".repeat(size);
  let total = 0;
  for (let i = 0; i < times; i++) {
    const t = s.copy();
    total = (total + apply((x: i32): i32 => x + t.length, i)) % 1000003;
  }
  return total;
}
