// Maps and sets crossing between JavaScript and the module, both ways.

struct Stock {
  name: String;
  price: f64;
  tags: Array<String>;
  active: bool;
}

export fn total(prices: Map<String, f64>): f64 {
  let sum = 0.0;
  for (const e of prices) {
    sum += e.1;
  }
  return sum;
}

export fn invert(m: Map<String, i32>): Map<i32, String> {
  let out: Map<i32, String> = Map.new();
  for (const e of m) {
    out.set(e.1, e.0.copy());
  }
  return out;
}

export fn stocks(names: Set<String>): Map<String, Stock> {
  let out: Map<String, Stock> = Map.new();
  let i = 0;
  for (const n of names) {
    out.set(n.copy(), Stock(`${n}!`, i.toF64() * 1.5, [n.copy(), "x"], i % 2 == 0));
    i += 1;
  }
  return out;
}

export fn bump(counts: inout Map<i64, i32>, key: i64): void {
  counts.set(key, counts.get(key).unwrapOr(0) + 1);
}

export fn evens(n: i32): Set<i32> {
  let s: Set<i32> = Set.new();
  for (let i = 0; i < n; i += 2) {
    s.add(i);
  }
  return s;
}

export fn nested(groups: Map<String, Map<i32, bool>>): i32 {
  let count = 0;
  for (const g of groups) {
    for (const e of g.1) {
      if (e.1) {
        count += e.0;
      }
    }
  }
  return count;
}
