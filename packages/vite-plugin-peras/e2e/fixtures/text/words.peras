// The methods of strings, behind exported functions.
export fn shout(s: String): String {
  return s.trim().toUpperCase().replaceAll(" ", "_");
}

export fn fields(line: String): Array<String> {
  return line.split(",").map((f) => f.trim());
}

export fn tidy(line: String): String {
  const named = line.split(",").map((f) => f.trim().toLowerCase()).filter((f) => !f.startsWith("#"));
  return named.join(" ");
}

export fn middle(s: String, start: i32, end: i32): String {
  return s.slice(start, end);
}

export fn find(s: String, needle: String): i32 {
  return s.indexOf(needle);
}

export fn characters(s: String): i32 {
  return s.split("").length;
}

// `const parts = line.split(",")`, only read and `line` unable to change: an
// array of views of `line` (decision 0014, finding F201).
export fn csvSum(text: String): i32 {
  let total = 0;
  for (const line of text.split("\n")) {
    const parts = line.split(",");
    if (parts.length == 3) {
      total += parts[0].parseI32().unwrapOr(0) * parts[2].length + parts[1].length;
    }
  }
  return total;
}

// A part copied out of the views lives on once they are released.
export fn firstKept(line: String): String {
  const parts = line.split(",");
  return parts[0].copy();
}

// The text changes while the parts live: they must be copies.
export fn afterChange(line: String): String {
  let t = line.copy();
  const parts = t.split(",");
  t += "!";
  return `${parts[0]}|${t}`;
}

// The array leaves the function: it must own its strings.
export fn partsOf(line: String): Array<String> {
  const parts = line.split(",");
  return parts;
}

// A string whose case changes, compared at once: compared byte by byte,
// without making it (decision 0014, finding F205).
export fn sameLower(a: String, b: String): bool {
  return a.toLowerCase() == b;
}

export fn sameUpper(a: String, b: String): bool {
  return b == a.toUpperCase();
}

export fn notLower(a: String, b: String): bool {
  return a.toLowerCase() != b;
}

// `for (const p of text.split(sep))` walked part by part, with no array
// (decision 0014): the parts of `split`, the last empty one included.
export fn partsComma(text: String): String {
  let out = "";
  let n = 0;
  for (const p of text.split(",")) {
    out += `${p}|`;
    n += 1;
  }
  return `${n}:${out}`;
}

export fn partsDash(text: String): String {
  let out = "";
  let n = 0;
  for (const p of text.split(" -- ")) {
    out += `${p}|`;
    n += 1;
  }
  return `${n}:${out}`;
}

// A part kept past the loop is a copy; the walk stops at the return.
export fn firstLong(text: String, min: i32): String {
  for (const p of text.split(";")) {
    if (p.length >= min) {
      return p.copy();
    }
  }
  return "";
}

export fn countUntil(text: String, stop: String): i32 {
  let n = 0;
  for (const p of text.split(",")) {
    if (p == stop) {
      break;
    }
    if (p.length == 0) {
      continue;
    }
    n += 1;
  }
  return n;
}

export fn nestedLengths(text: String): i32 {
  let n = 0;
  for (const line of text.split("\n")) {
    for (const f of line.split(",")) {
      n += f.length * 10 + 1;
    }
  }
  return n;
}

// The characters of a text walked one at a time, without an array of them
// (decision 0016, finding F207): each joined with "|", and their count.
export fn charsOf(text: String): String {
  let out = "";
  for (const c of text.split("")) {
    out += `${c}|`;
  }
  return out;
}

export fn upperCount(text: String, stop: String): i32 {
  let n = 0;
  for (const c of text.split("")) {
    if (c == stop) {
      break;
    }
    if (c.toLowerCase() != c) {
      n += 1;
    }
  }
  return n;
}


// Literals only read are lent from a static header, below the heap, made
// once (decision 0016, finding F211); past the room there, copied as before.
export fn literalLength(): i32 {
  return "static".length + "".length;
}

