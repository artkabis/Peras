export struct Stats {
  values: Array<f64>;
  count: i32;
}

export fn evens(n: i32): Array<i32> {
  let found: Array<i32> = [];
  for (let i = 0; i < n; i++) {
    if (i % 2 == 0) {
      found.push(i);
    }
  }
  return found;
}

export fn sum(xs: Array<f64>): f64 {
  let total = 0.0;
  for (const x of xs) {
    total += x;
  }
  return total;
}

export fn scale(xs: inout Array<f64>, k: f64): void {
  for (let i = 0; i < xs.length; i++) {
    xs[i] = xs[i] * k;
  }
}

export fn at(xs: Array<i32>, i: i32): i32 {
  return xs[i];
}

export fn wide(xs: Array<i64>): Array<i64> {
  let out = xs.copy();
  out.push(9007199254740993);
  return out;
}

export fn flags(n: i32): Array<bool> {
  let out: Array<bool> = [];
  for (let i = 0; i < n; i++) {
    out.push(i % 3 == 0);
  }
  return out;
}

export fn stats(values: sink Array<f64>): Stats {
  const count = values.length;
  return Stats(values, count);
}
