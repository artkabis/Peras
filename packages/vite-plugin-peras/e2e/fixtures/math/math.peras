// Decision 0035: `Math` as JavaScript writes it, the same values in an
// owned module and in a managed one.
export fn polar(x: f64, y: f64): String {
  const distance = Math.sqrt(x * x + y * y);
  const angle = Math.atan2(y, x) * 180 / Math.PI;
  return `${distance.toFixed(2)} ${angle.toFixed(1)}`;
}

export fn clamp(v: i32): i32 {
  return Math.min(Math.max(v, 0), 255);
}

export fn cents(price: f64): f64 {
  return Math.round(price * 100) / 100;
}

export fn percent(done: i32, total: i32): String {
  const value = ((done * 100).toF64() / total.toF64()).round();
  return `${value} %`;
}

export fn growth(rate: f64): f64 {
  return Math.pow(Math.E, rate) + Math.abs(-rate) + Math.floor(rate * 10) + Math.ceil(rate);
}
