{
  "name": "peras",
  "scopeName": "source.peras",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.peras", "match": "//.*$" },
        { "name": "comment.block.peras", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.peras",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.peras", "match": "\\\\(u\\{[0-9a-fA-F]+\\}|.)" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.peras", "match": "\\b0x[0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.binary.peras", "match": "\\b0b[01_]+\\b" },
        {
          "name": "constant.numeric.decimal.peras",
          "match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.peras",
          "match": "\\b(if|else|while|for|of|return|break|continue|match|await)\\b"
        },
        {
          "name": "storage.type.peras",
          "match": "\\b(fn|struct|enum|trait|impl|interface|type|class|let|const|import|export|async)\\b"
        },
        { "name": "storage.modifier.peras", "match": "\\b(inout|sink)\\b" },
        { "name": "constant.language.peras", "match": "\\b(true|false|None|Some)\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.peras",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|void)\\b"
        },
        { "name": "entity.name.type.peras", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "functions": {
      "name": "entity.name.function.peras",
      "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    "operators": {
      "name": "keyword.operator.peras",
      "match": "==|!=|<=|>=|&&|\\|\\||[-+*/%<>=!&|^~?]"
    }
  }
}
