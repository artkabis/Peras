// Each thread of a parallel loop has its own module variables: a turn would
// not see the value the code around the loop sees (decision 0023).
let k = 2;

export fn scale(n: i32): i32 {
  let xs: Array<i32> = [];
  for (let i = 0; i < n; i++) {
    xs.push(i);
  }
  parallel for (let i = 0; i < xs.length; i++) {
    xs[i] = xs[i] * k;
  }
  return xs[0];
}
