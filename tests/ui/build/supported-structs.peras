// Structures are their scalars: no heap. A function returning a structure has
// one result per field; a call to it runs first, into temporaries.
export struct Vec2 {
  x: f64;
  y: f64;
}

fn add(a: Vec2, b: Vec2): Vec2 {
  return Vec2(a.x + b.x, a.y + b.y);
}

export fn length(v: Vec2): f64 {
  return (v.x * v.x + v.y * v.y).sqrt();
}

export fn travel(steps: i32): Vec2 {
  let p = Vec2(0.0, 0.0);
  for (let i = 0; i < steps; i++) {
    p = add(p, Vec2(1.0, 0.5));
  }
  p = Vec2(p.y, p.x);
  return p;
}
