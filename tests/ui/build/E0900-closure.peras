// E0900: an arrow function used as a value copies what it captures into its
// environment, which holds numbers only for now (decision 0026): a string,
// an array, a structure holding one, or a function value captured is not
// compiled yet.
struct Named {
  name: String;
  size: i32;
}

fn apply(f: (i32) => i32, x: i32): i32 {
  return f(x);
}

export fn text(n: i32, s: String): i32 {
  return apply((x) => x + s.length, n);
}

export fn array(n: i32, xs: Array<i32>): i32 {
  return apply((x) => x + xs.length, n);
}

export fn holder(n: i32, named: Named): i32 {
  return apply((x) => x + named.size, n);
}

fn twice(x: i32): i32 {
  return x * 2;
}

fn wrapped(n: i32, g: (i32) => i32): i32 {
  return apply((x) => g(x) + 1, n);
}

export fn function(n: i32): i32 {
  return wrapped(n, twice);
}
