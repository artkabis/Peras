// E0206: `&` exactly on `inout` arguments.
fn clear(xs: inout Array<i32>): void {
  while (xs.length > 0) {
    xs.pop();
  }
}
fn read(xs: Array<i32>): i32 { return xs.length; }

export fn missing(): i32 {
  let xs: Array<i32> = [1, 2];
  clear(xs);
  return xs.length;
}

export fn extra(): i32 {
  let xs: Array<i32> = [1, 2];
  clear(&xs);
  return read(&xs);
}
