// E0238: an arrow function is written in place, as the argument of an array
// method that takes one; it is not a value yet.
export fn values(xs: Array<i32>): i32 {
  const twice = (x) => x * 2;
  const a = xs.map(twice);
  const b = xs.map(2);
  // The number of parameters, and their types, are the method's.
  const c = xs.map((x, y) => x);
  const d = xs.filter((x: f64) => x > 1.0);
  // A test gives a `bool`.
  const e = xs.filter((x) => x + 1);
  return a.length + b.length + c.length + d.length + e.length;
}

// Allowed: every method that takes one.
export fn fine(xs: Array<i32>): i32 {
  const m = xs.map((x) => x * 2).filter((x) => x > 2);
  const r = xs.reduce((acc: i32, x) => acc + x, 0);
  const f = xs.find((x) => x > 1).unwrapOr(0) + xs.findIndex(x => x == 3);
  let n = m.length + r + f;
  if (xs.some((x) => x < 0) || xs.every((x) => x > 0)) {
    n += 1;
  }
  return n;
}
