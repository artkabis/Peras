// Names and types: the spec's examples and every rule, without error.
export struct Buffer {
  samples: Array<f32>;
}

export fn gain(buf: inout Buffer, factor: f32): void {
  for (let i: i32 = 0; i < buf.samples.length; i++) {
    buf.samples[i] = buf.samples[i] * factor;
  }
}

export fn peak(buf: Buffer): Option<f32> {
  if (buf.samples.length == 0) return None;
  let max: f32 = 0.0;
  for (const s of buf.samples) { if (s.abs() > max) max = s.abs(); }
  return Some(max);
}

export fn fib(n: i32): i32 {
  if (n < 2) return n;
  return fib(n - 1) + fib(n - 2);
}

export fn mean(total: f64, count: i32): f64 {
  if (count == 0) return 0.0;
  return total / count.toF64();
}

export fn bounds(_unused: u8): i64 {
  const small: i8 = -128;
  const byte: u8 = 255;
  let wide: i64 = 9223372036854775807;
  wide -= small.toI64() + byte.toI64();
  for (;;) {
    if (wide > 0) return wide;
    wide += 1;
  }
}
