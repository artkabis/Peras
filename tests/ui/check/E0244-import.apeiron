// What an import may name: a function, a structure, and what is refused.
import { average, origin, Point } from "./stats.peras";
import { mean } from "./missing.peras";
// A generic structure does not cross.
import { Pair } from "./stats.peras";

export fn score(xs: Array<number>): number {
  const p: Point = origin();
  return p.x + xs[0];
}
